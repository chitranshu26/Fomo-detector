*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*

# Virtual environments (common names and tools)
venv/
venv*/
env/
env*/
ENV/
.venv/
.virtualenv/
.python-env/
virtualenv/
site-packages/

# Package and build outputs
build/
dist/
*.egg-info/
pip-wheel-metadata/
**/target/
**/.gradle/
*.class
*.war

# Generated runtime logs and temporary files
logs/
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# Local secrets and machine-specific environment configuration
.env
.env.*
!.env.example
!.env.template
.secrets/
*.pem
*.key

# IDE settings: keep .vscode/tasks.json and shared workspace configuration
.idea/
*.iml
.fleet/

# Operating system files
.DS_Store
._*
Thumbs.db
Desktop.ini

